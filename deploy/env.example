# The agent's environment file. Copy it somewhere outside this repository —
# /etc/proofdrill-agent/env is the obvious place on Linux — fill it in, and
# chmod 600 it. It holds a registration token and a storage key, and it is the
# only place on the machine either of them lives once the container is created
# from this file rather than from a hand-typed command.
#
#   docker compose -f deploy/compose.yaml --env-file /etc/proofdrill-agent/env up -d
#
# ---------------------------------------------------------------------------
# Three things about this file, each of which has cost somebody a deployment
# ---------------------------------------------------------------------------
#
# 1. DOUBLE EVERY LITERAL `$`. Compose interpolates `$` even inside an
#    --env-file, so a secret access key containing one arrives at the container
#    mutilated — and every request is then refused with a signature error that
#    says nothing about a dollar sign. Write `$$`. Quote anything with spaces.
#
# 2. DO NOT `source` IT IN A SHELL to check it. An exported variable WINS over
#    --env-file in compose's interpolation, so a value the shell mangled on the
#    way in is the value the container gets, and the file on disk still looks
#    right.
#
# 3. A VARIABLE HERE THAT IS NOT ALSO IN compose.yaml NEVER ARRIVES. The service
#    enumerates its environment one line at a time, deliberately, so adding a
#    line here is only half of any change.

# ---- who this agent is -----------------------------------------------------
# Both come from the registration page and are shown EXACTLY ONCE. There is no
# endpoint that returns the token a second time: it is the key this agent signs
# its reports with, so the control plane holds it encrypted rather than hashed
# and still will not hand it back. Lose it and the fix is a new agent, which is
# a new identity on the agents screen and not the same one repaired.
PROOFDRILL_AGENT_ID=CHANGEME
PROOFDRILL_TOKEN=CHANGEME

# ---- reaching your backups -------------------------------------------------
# READ-ONLY, and we would rather you proved it than believed it: the agent never
# writes to your bucket, and a key that could is a key whose blast radius is
# larger than anything this product needs.
#
# They are here rather than on the command line because a command line is
# readable by every process on the machine and lands in shell history. The agent
# refuses `--s3-access-key-id` outright for that reason, with that reason.
PROOFDRILL_S3_ACCESS_KEY_ID=CHANGEME
PROOFDRILL_S3_SECRET_ACCESS_KEY=CHANGEME

# ---- where to report -------------------------------------------------------
# The origin the registration page put into the command it generated. Nothing
# auto-updates, by decision, so this string stays true until a person edits it.
PROOFDRILL_CONTROL_PLANE=https://api.proofdrill.example

# ---- which machine this is -------------------------------------------------
# WRITE IT OUT. Compose has no shell, so `$(hostname)` here is four literal
# characters and not an answer.
#
# It is the name the agents screen shows and the name in the e-mail that tells
# somebody an agent has gone quiet — which is to say, it is the field whose only
# job is to send a person to the right box. Left unset, the agent falls back to
# the container id, which identifies nothing and changes every time the
# container is recreated.
PROOFDRILL_HOSTNAME=CHANGEME

# ---- which build ------------------------------------------------------------
# `1` moves with each release inside major 1, and moving is not updating: see
# the header of compose.yaml for why an update is two commands. Pin a full
# version — `1.2.0` — if you would rather decide release by release.
PROOFDRILL_IMAGE_TAG=1
